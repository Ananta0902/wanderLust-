<% layout("/layouts/boilerplate") %>

<div class="row mt-3 px-2 px-sm-0">
  <div class="col-12 col-md-8 offset-md-2">
    <h2 class="mb-4 fw-bold">Edit Your Listing</h2>
    
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
      
      <div class="mb-3">
        <label for="title" class="form-label fw-semibold">Title</label>
        <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control py-2" required />
        <div class="invalid-feedback">Title cannot be blank.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label fw-semibold">Description</label>
        <textarea name="listing[description]" class="form-control" rows="4" required><%= listing.description %></textarea>
        <div class="invalid-feedback">Please enter a valid description.</div>
      </div>

      <div class="mb-3">
        <p class="form-label fw-semibold mb-2">Original Listing Image</p>
        <div class="card border border-light-subtle rounded-3 overflow-hidden" style="max-width: 300px;">
         <img 
  src="<%= originalImageUrl %>" 
  class="img-fluid object-fit-cover" 
  style="height: 150px; width: 100%;" 
  alt="original_image" 
  onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=800&auto=format&fit=crop';"
/>
        </div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label fw-semibold">Upload New Image</label>
        <input name="listing[image]" type="file" class="form-control py-2" />
      </div>

      <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6">
          <label for="price" class="form-label fw-semibold">Price per night</label>
          <div class="input-group">
            <span class="input-group-text">&#8377;</span>
            <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control py-2" required />
            <div class="invalid-feedback">Please enter a valid price details value.</div>
          </div>
        </div>

        <div class="col-12 col-sm-6">
          <label for="country" class="form-label fw-semibold">Country</label>
          <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control py-2" required />
          <div class="invalid-feedback">Country name field is required.</div>
        </div>
      </div>

      <div class="mb-4">
        <label for="location" class="form-label fw-semibold">Location</label>
        <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control py-2" required />
        <div class="invalid-feedback">Location must be accurate.</div>
      </div>

      <div class="d-flex gap-3">
        <button class="btn btn-danger flex-grow-1 py-2.5 rounded-3 fw-bold shadow-sm">Save Changes</button>
        <a href="/listings/<%= listing._id %>" class="btn btn-dark py-2.5 rounded-3 px-4">Cancel</a>
      </div>

    </form>
  </div>
</div>


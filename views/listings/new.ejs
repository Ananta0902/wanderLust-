<% layout("/layouts/boilerplate") %>

<div class="row mt-3 px-2 px-sm-0">
  <div class="col-12 col-md-8 offset-md-2">
    <h2 class="mb-4 fw-bold">Create a New Listing</h2>
    
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
      
      <div class="mb-3">
        <label for="title" class="form-label fw-semibold">Title</label>
        <input name="listing[title]" placeholder="Catchy title (e.g., Cozy Beachfront Cabin)" type="text" class="form-control py-2" required />
        <div class="invalid-feedback">Please enter a valid title.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label fw-semibold">Description</label>
        <textarea name="listing[description]" placeholder="Describe your beautiful place..." class="form-control" rows="4" required></textarea>
        <div class="invalid-feedback">Please enter a short description.</div>
      </div>

      <div class="mb-3">
        <label for="image" class="form-label fw-semibold">Upload Image</label>
        <input name="listing[image]" type="file" class="form-control py-2" required />
        <div class="invalid-feedback">Please upload an image file.</div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-12 col-sm-6">
          <label for="price" class="form-label fw-semibold">Price per night</label>
          <div class="input-group">
            <span class="input-group-text">&#8377;</span>
            <input name="listing[price]" placeholder="1200" type="number" class="form-control py-2" required />
            <div class="invalid-feedback">Please enter a valid price.</div>
          </div>
        </div>

        <div class="col-12 col-sm-6">
          <label for="country" class="form-label fw-semibold">Country</label>
          <input name="listing[country]" placeholder="India" type="text" class="form-control py-2" required />
          <div class="invalid-feedback">Please enter a valid country name.</div>
        </div>
      </div>

      <div class="mb-4">
        <label for="location" class="form-label fw-semibold">Location</label>
        <input name="listing[location]" placeholder="Mumbai, Maharashtra" type="text" class="form-control py-2" required />
        <div class="invalid-feedback">Please enter a valid location.</div>
      </div>

      <button class="btn btn-danger w-100 py-2.5 rounded-3 fw-bold shadow-sm">Add Listing</button>

    </form>
  </div>
</div>
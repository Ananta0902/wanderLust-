<% layout("/layouts/boilerplate") %> 
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>; 
</script>

<style>
  /* Localized fix for the map container responsiveness */
  #map {
    width: 100%;
    height: 350px;
    border-radius: 12px;
  }
  
  /* Make sure the main show card doesn't scale weirdly */
  .show-img {
    height: 30vh !important;
    min-height: 250px;
    max-height: 400px;
    object-fit: cover;
    border-radius: 12px !important;
  }

  /* Chat Popup adjustments for small screens */
  @media (max-width: 576px) {
    .chat-popup {
      width: 90% !important;
      right: 5% !important;
      left: 5% !important;
      bottom: 20px !important;
    }
  }
  /* Localized fix for the map container responsiveness */
  #map {
    width: 100%;
    height: 350px;
    border-radius: 12px;
  }
  
  /* Make sure the main show card doesn't scale weirdly */
  .show-img {
    height: 30vh !important;
    min-height: 250px;
    max-height: 400px;
    object-fit: cover;
    border-radius: 12px !important;
  }

  /* Property Chat Popup Layout Fixes */
  .chat-popup {
    position: fixed;
    bottom: 90px; /* Elevated slightly so it doesn't get blocked by navigation or floating triggers */
    right: 20px;
    width: 350px;
    max-height: 500px;
    background-color: white;
    border-radius: 16px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    display: none;
    flex-direction: column;
    overflow: hidden;
    z-index: 9999 !important; /* Forces it completely above the global "AI Travel Guide" button */
    border: 1px solid #eee;
  }

  @media (max-width: 576px) {
    .chat-popup {
      width: calc(100% - 32px) !important;
      right: 16px !important;
      left: 16px !important;
      bottom: 85px !important;
      max-height: 70vh !important;
    }
  }
</style>

<div class="row mt-3 px-2 px-md-0">
  <div class="col-12 col-md-8 offset-md-2">
    <h3 class="mb-3"><%= listing.title %></h3>
  </div>

  <div class="card col-12 col-md-8 offset-md-2 show-card listing-card border-0 bg-transparent">
    <img 
  src="<%= listing.image.url %>" 
  class="card-img-top show-img" 
  alt="listing_image"
  onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1571896349842-33c89424de2d?q=80&w=800&auto=format&fit=crop';"
>
    
    <div class="card-body px-0 pt-3">
      <p class="card-text mb-2 text-muted">
        Owned By ~ <i><%= listing.owner ? listing.owner.username : "Unknown user" %></i>
      </p>
      <p class="card-text fs-5 mb-2"><%= listing.description %></p>
      <p class="card-text fw-bold fs-4 text-danger mb-2">&#8377; <%= listing.price.toLocaleString("en-IN") %> <span class="fs-6 text-muted fw-normal">per night</span></p>
      <p class="card-text mb-1"><i class="fa-solid fa-location-dot text-secondary me-2"></i><%= listing.location %></p>
      <p class="card-text mb-3"><i class="fa-solid fa-earth-americas text-secondary me-2"></i><%= listing.country %></p>
      
    <div class="d-flex gap-2 flex-wrap mt-3 w-100">
  <a href="/ai/trip-planner?destination=<%= listing.location %>" class="btn btn-danger py-2 flex-grow-1 flex-sm-grow-0">
    ✨ Plan My <%= listing.location %> Trip
  </a>
  <button class="btn btn-outline-danger py-2 flex-grow-1 flex-sm-grow-0" onclick="openPropertyChat()">
    🤖 Ask About This Place
  </button>
</div>

<script>
  window.listingData = {
    title: "<%= listing.title %>",
    location: "<%= listing.location %>",
    country: "<%= listing.country %>",
    price: "<%= listing.price %>"
  };
</script>

<div id="propertyChatPopup" class="chat-popup">
  <div class="chat-header d-flex justify-content-between align-items-center bg-danger text-white p-3">
    <span class="fw-bold">🤖 WanderLust AI Guide</span>
    <button onclick="closePropertyChat()" class="btn btn-sm text-white p-0 fs-5 lh-1" style="background:none; border:none; shadow:none;">&times;</button>
  </div>
  
  <div id="chatMessages" class="chat-messages p-3 flex-grow-1 overflow-y-auto" style="background-color: #f8f9fa;"></div>
  
  <div class="chat-input-box d-flex p-2 border-top bg-white">
    <input id="chatInput" type="text" class="form-control me-2 rounded-pill" placeholder="Ask about this place..." style="font-size: 0.9rem;">
    <button onclick="sendMessage()" class="btn btn-danger btn-sm rounded-pill px-3">Send</button>
  </div>
</div>

<script src="/js/chat.js"></script>
    </div>
  </div>

  <% if(currUser && listing.owner && String(listing.owner._id) === String(currUser._id)) { %>
    <div class="col-12 col-md-8 offset-md-2 my-2 d-flex gap-3">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4 py-2 edit-btn flex-grow-1 flex-sm-grow-0">Edit</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="flex-grow-1 flex-sm-grow-0 m-0">
        <button class="btn btn-danger w-100 px-4 py-2">Delete</button>
      </form>
    </div>
  <% } %>

  <div class="col-12 col-md-8 offset-md-2 mb-3">
    <% if(currUser) { %>
      <hr class="my-4"/>
      <h4 class="mb-3">Leave a Review</h4>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        
        <div class="mb-2">
          <label for="rating" class="form-label fw-semibold">Rating</label>
          <fieldset class="starability-heart">
             <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
             <input type="radio" id="first-rate1" name="review[rating]" value="1" />
             <label for="first-rate1" title="Terrible">1 star</label>
             <input type="radio" id="first-rate2" name="review[rating]" value="2" />
             <label for="first-rate2" title="Not good">2 stars</label>
             <input type="radio" id="first-rate3" name="review[rating]" value="3" />
             <label for="first-rate3" title="Average">3 stars</label>
             <input type="radio" id="first-rate4" name="review[rating]" value="4" />
             <label for="first-rate4" title="Very good">4 stars</label>
             <input type="radio" id="first-rate5" name="review[rating]" value="5" />
             <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>

        <div class="mb-3">
          <label for="comment" class="form-label fw-semibold">Comments</label>
          <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" placeholder="Tell us about your experience..." required></textarea>
          <div class="invalid-feedback">Please add some comments for review</div>
        </div>
        
        <button class="btn btn-outline-dark px-4">Submit</button>
      </form>
    <% } %>

    <hr class="my-4"/>

    <% if(listing.reviews && listing.reviews.length > 0) { %>
      <h5 class="mb-3 fw-bold">All Reviews</h5>
      <div class="row g-3">
        <% for(let review of listing.reviews) { %>
          <div class="col-12 col-sm-6">
            <div class="card h-100 shadow-sm border">
              <div class="card-body d-flex flex-column justify-content-between p-3">
                <div>
                  <h6 class="card-title fw-bold mb-1">@<%= review.author.username %></h6>
                  <p class="starability-result mb-2" data-rating="<%= review.rating %>"></p>
                  <p class="card-text text-secondary small"><%= review.comment %></p>
                </div>
                <form class="mt-3 mb-0" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>

  <div class="col-12 col-md-8 offset-md-2 my-4">
    <h4 class="mb-3">Where you'll be</h4>
    <div id="map" class="shadow-sm border"></div>
  </div>
</div>

<script src="/js/map.js"></script>
